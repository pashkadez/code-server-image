{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["codercom/code-server"],
      "automerge": false,
      "commitMessagePrefix": "chore(deps):",
      "labels": ["dependencies"]
    }
  ],
  "prConcurrentLimit": 2
}
